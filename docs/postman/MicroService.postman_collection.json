{
	"info": {
		"_postman_id": "b1f6e2a0-0000-4a00-9000-microservice01",
		"name": "MicroService API",
		"description": "Importable collection for the MicroService REST framework (CodeIgniter 4). Bearer API-key auth is set at the collection level so every request — and any n8n HTTP Request node modelled on these — inherits it. Set the `baseUrl` and `apiKey` collection variables (or import the matching environment) before sending.\n\n**Contract**\n- Success: `{ \"data\": ..., \"meta\": ... }` (`meta` omitted when empty; collections carry `meta.pagination`).\n- Errors: RFC 9457 `application/problem+json` (`{type,title,status,detail?,requestId,errors?}`).\n- Every response carries an `X-Request-Id` (echoed, or supply your own to correlate an n8n run).\n- Writes must send `Content-Type: application/json` (else 415) with valid JSON (else 400).\n- Responses deliberately carry **no** PHP/CodeIgniter/Apache fingerprints.\n\n**Resources** are config-driven: `products` is the sample. Run **Create product** first — its test script stores the new id into `productId`, which the Get/Update/Delete requests reuse.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{apiKey}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
		{ "key": "apiKey", "value": "", "type": "string" },
		{ "key": "productId", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Health",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "X-Request-Id", "value": "{{$guid}}", "description": "Optional correlation id (echoed back). Remove to let the service mint one." }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "health"]
						},
						"description": "Liveness/readiness probe. Pings the external database; `{data:{status,service,time,checks}}`. 200 healthy, 503 degraded. Unauthenticated."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('engine is hidden', () => {",
									"    pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
									"    pm.expect(pm.response.headers.get('Server')).to.eql('MicroService');",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Unknown path (neutral 404 example)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/problem+json" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/does-not-exist",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "does-not-exist"]
						},
						"description": "Shows the neutral error shape: unknown paths return RFC 9457 problem+json with no engine disclosure. The same shape is returned for every error status."
					},
					"response": []
				},
				{
					"name": "Discover resources",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/_resources",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "_resources"]
						},
						"description": "Self-description of the API: every registered resource with its endpoint, output fields, writable fields, sortable/filterable columns, supported operators, and pagination caps. Will be auth-gated once auth lands."
					},
					"response": []
				}
			]
		},
		{
			"name": "Products",
			"description": "CRUD for the sample `products` resource (generic config-driven engine).",
			"item": [
				{
					"name": "List products",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products?page=1&perPage=25&sort=-created_at",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "perPage", "value": "25", "description": "Capped at the resource max (100)." },
								{ "key": "sort", "value": "-created_at", "description": "Prefix '-' for descending. Only whitelisted columns: sku, name, price, created_at." }
							]
						},
						"description": "Paginated list: `{data:[...], meta:{pagination:{page,perPage,total,totalPages}}}`."
					},
					"response": []
				},
				{
					"name": "List products (filter + sparse fields)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products?filter[status]=active&filter[price][gte]=10&fields=id,sku,price&sort=-price",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"],
							"query": [
								{ "key": "filter[status]", "value": "active", "description": "Equality filter (operator defaults to eq)." },
								{ "key": "filter[price][gte]", "value": "10", "description": "Operators: eq, ne, gt, gte, lt, lte, like, in. Only filterable columns: sku, status, price." },
								{ "key": "fields", "value": "id,sku,price", "description": "Sparse fieldset — restrict returned columns (allow-listed)." },
								{ "key": "sort", "value": "-price" }
							]
						},
						"description": "Filtering and sparse fieldsets are allow-listed and parameter-bound. Unknown columns/operators/fields return 400 problem+json."
					},
					"response": []
				},
				{
					"name": "Create product",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sku\": \"SKU-1001\",\n    \"name\": \"Sample Widget\",\n    \"price\": \"19.99\",\n    \"status\": \"active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"]
						},
						"description": "Creates a product. 201 + `Location` header. Validation errors return 422 problem+json with a per-field `errors` map."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 201', () => pm.response.to.have.status(201));",
									"const id = pm.response.json().data.id;",
									"pm.collectionVariables.set('productId', id);",
									"pm.test('Location header set', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/products/'));"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Get product",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "{{productId}}"]
						},
						"description": "Fetch one product by id. Unknown id → neutral 404 problem+json."
					},
					"response": []
				},
				{
					"name": "Update product",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Renamed Widget\",\n    \"price\": \"24.50\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "{{productId}}"]
						},
						"description": "Partial update (PATCH) or full replace (PUT). Only fillable fields are accepted; others are ignored."
					},
					"response": []
				},
				{
					"name": "Delete product",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "{{productId}}"]
						},
						"description": "Deletes a product. 204 No Content. (Becomes an archival/recycle-bin delete in a later phase — see ARCHITECTURE §14.)"
					},
					"response": []
				}
			]
		}
	]
}
