                    },
                    {
                        "name": "fields",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated sparse fieldset. Allowed: id, sku, name, price, status, created_at, updated_at.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "filter[sku]",
                        "in": "query",
                        "required": false,
                        "description": "Filter. Columns: sku, status, price. Operators: eq, ne, gt, gte, lt, lte, like, in (e.g. filter[col][gte]=10).",
