# =============================================================================
#  ENVIRONMENT TEMPLATE  (safe to commit — contains NO real secrets)
#  Copy to `.env` and fill in real values:   cp .env.example .env
#  `.env` is gitignored and holds the actual local credentials.
# =============================================================================

#------------------------------------------------------------------------------
# CodeIgniter 4 application
#------------------------------------------------------------------------------
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

#------------------------------------------------------------------------------
# Cache — backs the per-key rate-limit counters.
# Dev/host: 'file' (no extension needed). Production/container: 'redis'.
#------------------------------------------------------------------------------
# cache.handler = redis
# cache.redis.host = 127.0.0.1
# cache.redis.port = 6379
REDIS_HOST_PORT=6379

#------------------------------------------------------------------------------
# Outbound webhooks — notify an n8n webhook node on resource changes.
# Enqueued on mutation; delivered (HMAC-signed) by `php spark webhooks:dispatch`
# (run on a schedule). Events: {resource}.{afterCreate|afterUpdate|afterDelete|
# afterRestore}; use '*' for all. Leave WEBHOOK_URL empty to disable.
#------------------------------------------------------------------------------
# WEBHOOK_URL = https://n8n.example.com/webhook/your-id
# WEBHOOK_SECRET = a-shared-secret-for-the-X-Signature-hmac
# WEBHOOK_EVENTS = *
# Seconds between the scheduler sidecar's webhooks:dispatch runs (delivery latency).
# DISPATCH_INTERVAL = 30

#------------------------------------------------------------------------------
# Docker deployment (docker-compose, EXTERNAL DB) — these are read by
# docker-compose.yml, not the app's dotted keys below. For the local
# dev-DB-on-host flow the defaults work as-is; for a REAL external database set
# DB_HOST (and DB_PORT) to it. DB_NAME/USER/PASSWORD come from the MYSQL_* values.
#------------------------------------------------------------------------------
# DB_HOST = your-db-host.internal          # default: host.docker.internal (dev DB on host)
# DB_PORT = 3306
# APP_BASE_URL = https://api.example.com/  # public base URL for Location/Link headers

#------------------------------------------------------------------------------
# Data retention for `php spark maintenance:prune` (days). Optional — the
# built-in defaults are shown; audit_log and the recycle bin are never pruned.
# Set any of these to 0 to KEEP FOREVER (disable pruning for that table); a
# non-numeric value is treated as 0. It never means "delete everything".
#------------------------------------------------------------------------------
# RETENTION_ACCESS_LOG_DAYS = 30
# RETENTION_DELIVERED_WEBHOOK_DAYS = 7
# RETENTION_DEADLETTERED_WEBHOOK_DAYS = 30

#------------------------------------------------------------------------------
# MySQL dev container  (consumed by docker-compose.dev.yml)
#  Generate strong values, e.g.:  openssl rand -hex 20
#------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=microservice
MYSQL_USER=microservice
MYSQL_PASSWORD=change-me-app
MYSQL_HOST_PORT=3307

#------------------------------------------------------------------------------
# CodeIgniter 4 database connection  (used from Phase 0 onward)
# MySQL is EXTERNAL; the app connects over TCP to the published host port.
#------------------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.port = 3307
database.default.database = microservice
database.default.username = microservice
database.default.password = change-me-app
database.default.DBDriver = MySQLi
database.default.pConnect = true
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#------------------------------------------------------------------------------
# Separate database used by the test suite (auto-created by the container)
#------------------------------------------------------------------------------
database.tests.hostname = 127.0.0.1
database.tests.port = 3307
database.tests.database = microservice_test
database.tests.username = microservice
database.tests.password = change-me-app
database.tests.DBDriver = MySQLi
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci
