# Keep secrets, VCS, and rebuildable/big dirs out of the image build context.
.git
.gitignore
.env
.env.local
*.env.local
/vendor/
/writable/cache/*
/writable/logs/*
/writable/debugbar/*
/writable/session/*
/build/
.phpunit.cache
.phpunit.result.cache
node_modules
.claude
.qodo
.vscode
docs
tests
phpunit.dist.xml
phpcs.xml.dist
phpstan.neon
phpstan-baseline.neon
docker-compose*.yml
